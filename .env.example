# Drizzle. A Neon host uses the HTTP driver the Worker needs; anything else
# gets the ordinary wire protocol, so a local PostgreSQL works in development.
DATABASE_URL="postgres://localhost:5432/naex"

# Optional. Integration tests run only when this is set, and they must never
# point at the development database — a separate local database or a Neon
# branch. It has to be exported, not only written here: the config reads it
# before Vite loads this file.
TEST_DATABASE_URL=""

# Salt for hashing client addresses used by rate limiting. Required in production.
RATE_LIMIT_SALT=""

# Optional. Events one address may create per hour. Defaults to 10.
MAX_EVENTS_PER_HOUR=""

# Required for POST /api/udrzba, which prunes expired events and keeps the
# public demo alive. Without it the endpoint refuses to run.
MAINTENANCE_SECRET=""
